{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vjstudio.pro/schemas/generation-request.schema.json",
  "title": "GenerationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_name",
    "seed_prompt",
    "style",
    "duration_seconds",
    "frame_rate",
    "resolution",
    "loop_type",
    "tempo_bpm",
    "audio_reactive",
    "color_palette",
    "asset_type",
    "export_targets",
    "variants",
    "constraints",
    "metadata",
    "callbacks"
  ],
  "properties": {
    "project_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "seed_prompt": { "type": "string", "minLength": 3, "maxLength": 4000 },
    "style": { "type": "string", "minLength": 1, "maxLength": 120 },
    "duration_seconds": { "type": "number", "minimum": 1, "maximum": 600 },
    "frame_rate": { "type": "integer", "minimum": 12, "maximum": 240 },
    "resolution": { "type": "string", "pattern": "^\\d{3,5}x\\d{3,5}$" },
    "loop_type": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tempo_bpm": {
      "anyOf": [
        { "type": "number", "minimum": 20, "maximum": 300 },
        { "type": "null" }
      ]
    },
    "audio_reactive": { "type": "boolean" },
    "color_palette": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "asset_type": { "type": "string", "minLength": 1, "maxLength": 80 },
    "export_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "diversity"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "diversity": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_triangles",
        "max_texture_size",
        "max_file_size_mb",
        "gpu_budget_ms"
      ],
      "properties": {
        "max_triangles": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 20000000 },
            { "type": "null" }
          ]
        },
        "max_texture_size": {
          "anyOf": [
            { "type": "integer", "minimum": 128, "maximum": 16384 },
            { "type": "null" }
          ]
        },
        "max_file_size_mb": {
          "anyOf": [
            { "type": "number", "minimum": 1, "maximum": 4096 },
            { "type": "null" }
          ]
        },
        "gpu_budget_ms": {
          "anyOf": [
            { "type": "number", "minimum": 0.1, "maximum": 200 },
            { "type": "null" }
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags", "license", "author", "project_version"],
      "properties": {
        "tags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "license": { "type": "string", "minLength": 1, "maxLength": 120 },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "project_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "callbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webhook_url", "notify_on_complete"],
      "properties": {
        "webhook_url": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "notify_on_complete": { "type": "boolean" }
      }
    }
  }
}
