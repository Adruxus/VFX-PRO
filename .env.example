# Public client keys (safe for browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Feature flags
VITE_ENABLE_MARKETPLACE=true
VITE_ENABLE_SETLIST_GENERATOR=true
VITE_ENABLE_AUTH=true
VITE_ALLOW_LOCAL_BILLING_FALLBACK=false

# Browser -> orchestrator auth token (must match ORCHESTRATOR_API_TOKEN)
# Keep this scoped to trusted environments only.
VITE_ORCHESTRATOR_API_TOKEN=replace_with_long_random_token

# Server-side provider keys (Netlify env vars - DO NOT expose as VITE_*)
REPLICATE_API_TOKEN=r8_xxx
HUGGINGFACE_API_KEY=hf_xxx

# Internal API security
ORCHESTRATOR_API_TOKEN=replace_with_long_random_token
INTERNAL_API_ALLOW_UNAUTH=false

# CORS allowlist (comma-separated exact origins)
CORS_ALLOW_ORIGINS=https://vfx-studios.com,https://www.vfx-studios.com,http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_PROVIDER_FILE=90
RATE_LIMIT_REPLICATE_PREDICTION=30
RATE_LIMIT_REPLICATE_POLL=180
RATE_LIMIT_HUGGINGFACE_INFER=30
RATE_LIMIT_BILLING_ENTRIES=80
RATE_LIMIT_BILLING_CREDITS=120

# Optional Supabase server settings for billing/credits persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BILLING_LEDGER_TABLE=billing_ledger_entries
SUPABASE_CREDITS_TABLE=credit_balances
REQUIRE_SERVER_BILLING_DB=true
